  "keyFeatures": [
    "Service-worker-based URL rewriting via Ultraviolet core",
    "Express server with static asset serving for UV, Epoxy, and BareMux",
    "WebSocket tunneling via Wisp protocol",
    "EpoxyTransport for encrypted HTTP connections",
    "BareMux transport abstraction layer",
    "XOR URL encoding for basic obfuscation",
    "Docker and Docker Compose support for containerized deployment",
    "One-click deploy to Replit, Railway, and Koyeb",
    "Graceful SIGTERM/SIGINT shutdown handling",
    "COOP/COEP headers for SharedArrayBuffer support"
  ],
  "publicApiSurface": [
    "GET /* — serves static public assets",
    "GET /uv/* — serves Ultraviolet core files",
    "GET /epoxy/* — serves EpoxyTransport files",
    "GET /baremux/* — serves BareMux worker files",
    "WS /wisp/ — Wisp WebSocket tunnel endpoint",
    "GET * (404 fallback) — returns 404.html",
    "__uv$config.prefix — proxied URL prefix (/uv/service/)",
    "__uv$config.encodeUrl — XOR URL encoder",
    "__uv$config.decodeUrl — XOR URL decoder",
    "search(input, template) — resolves user input to a fully qualified URL",
    "registerSW() — registers the Ultraviolet service worker",
    "PORT environment variable — configures listen port (default 8080)"
  ]
}
